# Loom Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider API Keys (at least one required for non-Ollama usage)
# =============================================================================

# Anthropic (recommended for best quality)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Ollama (local, no key needed - just set the host if not default)
OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Optional: LangSmith Tracing
# =============================================================================

# Enable LangSmith tracing (requires langsmith package: pip install langsmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=loom

# =============================================================================
# Optional: Web Search (for Architect agent)
# =============================================================================

# Tavily API key for web search capability
TAVILY_API_KEY=

# =============================================================================
# Loom Configuration
# =============================================================================

# Default LLM provider and model (format: provider:model)
# Examples: anthropic:claude-sonnet-5, openai:gpt-4o, ollama:qwen2.5-coder:7b
LOOM_LLM_DEFAULT=ollama:qwen2.5-coder:7b

# Per-agent LLM overrides (optional)
# LOOM_LLM_DEVOPS=anthropic:claude-haiku-4-5
# LOOM_LLM_QA=anthropic:claude-sonnet-5

# Output directory for generated projects
LOOM_OUTPUT_DIR=./output

# Maximum retries for failed QA
LOOM_MAX_RETRIES=2

# Cost budget in USD (optional, stops build if exceeded)
# LOOM_COST_BUDGET_USD=5.0

# =============================================================================
# Sandbox Configuration
# =============================================================================

# Use Docker sandbox (recommended for safety)
LOOM_USE_DOCKER_SANDBOX=true

# Sandbox timeout in seconds
LOOM_SANDBOX_TIMEOUT=90

# Sandbox memory limit in MB
LOOM_SANDBOX_MEMORY_MB=512

# DANGER: Enable subprocess sandbox (only for development without Docker)
# LOOM_UNSAFE_SANDBOX=1
